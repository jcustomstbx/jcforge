{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JCForge",
  "version": "0.1.0",
  "identifier": "com.jcforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JCForge",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#101216"
      },
      {
        "label": "dock",
        "url": "index.html?window=dock",
        "title": "JCForge dock",
        "width": 304,
        "height": 460,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "backgroundColor": "#121418",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe", "binaries/whisper-cli"],
    "resources": ["models/*.bin"]
  }
}
